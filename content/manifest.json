---
layout: null
sitemap: false
---
{%- assign files = site.static_files | where_exp: "f", "f.path contains '/content/'" -%}
{%- assign pages = site.pages | where_exp: "p", "p.path contains 'content/'" -%}
{
  "generator": "jekyll",
  "built": {{ site.time | date_to_xmlschema | jsonify }},
  "files": [
    {%- for f in files %}
    {{ f.path | jsonify }}{% unless forloop.last %},{% endunless %}
    {%- endfor %}
  ],
  "pages": [
    {%- for p in pages %}
    {{ p.path | jsonify }}{% unless forloop.last %},{% endunless %}
    {%- endfor %}
  ]
}
